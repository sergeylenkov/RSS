{
  "name": "client",
  "version": "1.2.6",
  "private": true,
  "dependencies": {
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.9.0",
    "react-transition-group": "^4.4.5",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.21.3",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.21.0",
    "@eslint/js": "^8.57.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.5",
    "babel-loader": "^9.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.36.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-sonar": "^0.2.15",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-order": "^8.1.2",
    "stylelint-processor-styled-components": "^1.10.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "start": "webpack serve --config ./config/webpack.dev.js",
    "build:dev": "webpack --config ./config/webpack.dev.js",
    "build:prod": "webpack --config ./config/webpack.prod.js",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint --config ./config/eslint.config.js src/",
    "lint:report": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint --config ./config/eslint.config.js --format json --output-file reports/eslint-report.json src/",
    "lint:styles": "stylelint --config ./config/stylelint.config.js **/*.scss",
    "test": "jest --config ./config/jest.config.js --coverage=false",
    "test:coverage": "jest --config ./config/jest.config.js --coverage=true",
    "test:update": "jest --config ./config/jest.config.js --update-snapshot",
    "scan": "npm run test:coverage && npm run lint:report",
    "prettier:check": "prettier --config ./config/prettier.config.js --check .",
    "prettier:write": "prettier --config ./config/prettier.config.js --write ."
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
